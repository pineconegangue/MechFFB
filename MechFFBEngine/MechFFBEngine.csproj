<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- Copy SDL2.dll to output directory if it exists -->
  <Target Name="CopySDL2" AfterTargets="Build">
    <Copy SourceFiles="$(ProjectDir)SDL2.dll" 
          DestinationFolder="$(OutDir)" 
          SkipUnchangedFiles="true" 
          Condition="Exists('$(ProjectDir)SDL2.dll')" />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\MechFFBReader\MechFFBReader.csproj" />
  </ItemGroup>

</Project>
