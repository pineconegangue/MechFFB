<Window x:Class="MechFFBUI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MechFFB - Force Feedback for MechWarrior 5" 
        Height="600" Width="800"
        Background="{StaticResource BackgroundBrush}"
        WindowStartupLocation="CenterScreen">
    
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource PrimaryBrush}" 
                BorderBrush="{StaticResource AccentBrush}" BorderThickness="2" 
                Padding="15" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="MechFFB" FontSize="28" FontWeight="Bold" 
                          HorizontalAlignment="Center"/>
                <TextBlock Text="Real-time Force Feedback for MechWarrior 5: Mercenaries" 
                          FontSize="14" HorizontalAlignment="Center" Opacity="0.8"/>
            </StackPanel>
        </Border>
        
        <!-- Device Selection -->
        <Border Grid.Row="1" Background="{StaticResource PrimaryBrush}" 
                BorderBrush="{StaticResource SecondaryBrush}" BorderThickness="1" 
                Padding="10" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Force Feedback Device" FontWeight="Bold" FontSize="14"/>
                <Grid Margin="0,5,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    
                    <ComboBox x:Name="DeviceComboBox" Grid.Column="0" 
                             DisplayMemberPath="Name"
                             SelectionChanged="DeviceComboBox_SelectionChanged"/>
                    
                    <Button Grid.Column="1" Content="Refresh Devices" 
                           Click="RefreshDevices_Click" Width="120"/>
                    
                    <Button Grid.Column="2" Content="Test Device" 
                           Click="TestDevice_Click" Width="100"
                           IsEnabled="{Binding IsDeviceSelected}"/>
                </Grid>
            </StackPanel>
        </Border>
        
        <!-- Main Content Area with Tabs -->
        <TabControl Grid.Row="2" Background="{StaticResource PrimaryBrush}"
                   BorderBrush="{StaticResource SecondaryBrush}">
            
            <!-- Simple Mode Tab -->
            <TabItem Header="Settings" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Master Intensity" FontWeight="Bold" FontSize="14" Foreground="{StaticResource AccentBrush}"/>
                        <Grid Margin="0,5,0,15">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MasterIntensitySlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="100" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MasterIntensitySlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      FontWeight="Bold" FontSize="14" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Weapon Effects Section -->
                        <TextBlock Text="Weapon Recoil" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" Foreground="{StaticResource AccentBrush}"/>
                        
                        <!-- Ballistics -->
                        <TextBlock Text="Ballistics (Autocannons)" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BallisticSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=BallisticSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Lasers -->
                        <TextBlock Text="Lasers" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LaserSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- PPCs -->
                        <TextBlock Text="PPCs" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="PPCSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=PPCSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Missiles -->
                        <TextBlock Text="Missiles" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MissileSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Melee -->
                        <TextBlock Text="Melee" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MeleeSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MeleeSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Damage & Impact Section -->
                        <TextBlock Text="Incoming Damage" FontWeight="Bold" FontSize="14" Margin="0,20,0,5" Foreground="{StaticResource AccentBrush}"/>
                        
                        <!-- Laser Damage -->
                        <TextBlock Text="Laser Damage" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LaserDamageSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserDamageSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Ballistic Damage -->
                        <TextBlock Text="Ballistic Damage" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="BallisticDamageSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=BallisticDamageSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Missile Damage -->
                        <TextBlock Text="Missile Damage" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MissileDamageSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileDamageSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Melee Damage -->
                        <TextBlock Text="Melee Damage" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="MeleeDamageSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MeleeDamageSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Explosion Damage -->
                        <TextBlock Text="Explosion Damage" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="ExplosionDamageSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=ExplosionDamageSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Impacts Section -->
                        <TextBlock Text="Impacts" FontWeight="Bold" FontSize="14" Margin="0,15,0,5" Foreground="{StaticResource AccentBrush}"/>
                        
                        <!-- Landing -->
                        <TextBlock Text="Landing Impacts" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="LandingSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="60" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=LandingSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Movement Section -->
                        <TextBlock Text="Movement" FontWeight="Bold" FontSize="14" Margin="0,20,0,5" Foreground="{StaticResource AccentBrush}"/>
                        
                        <!-- Footsteps -->
                        <TextBlock Text="Footsteps" FontWeight="SemiBold" FontSize="12" Margin="0,5,0,0"/>
                        <Grid Margin="0,3,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="FootstepSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="30" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=FootstepSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        
                        <!-- Jump Jets -->
                        <TextBlock Text="Jump Jets" FontWeight="SemiBold" FontSize="12" Margin="0,0,0,0"/>
                        <Grid Margin="0,3,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Slider x:Name="JumpJetSlider" Grid.Column="0" 
                                   Minimum="0" Maximum="100" Value="50" 
                                   TickFrequency="10" IsSnapToTickEnabled="True"
                                   ValueChanged="IntensitySlider_ValueChanged"/>
                            <TextBlock Grid.Column="1" Text="{Binding ElementName=JumpJetSlider, Path=Value, StringFormat={}{0:F0}%}" 
                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            
            <!-- Advanced Mode Tab -->
            <TabItem Header="Advanced Mode" FontSize="14">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="Advanced Configuration" FontWeight="Bold" FontSize="16" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,10"/>
                        <TextBlock Text="Fine-tune duration, frequency, and envelope for each effect type" 
                                  Opacity="0.8" Margin="0,0,0,15"/>
                        
                        <!-- Weapon Fire Effects -->
                        <Expander Header="🔫 Weapon Fire Effects" FontWeight="Bold" FontSize="13" IsExpanded="True" Margin="0,5,0,5">
                            <StackPanel Margin="15,10,0,10">
                                
                                <!-- Ballistics -->
                                <TextBlock Text="Ballistics (Autocannons)" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,5,0,5"/>
                                <TextBlock Text="Duration (ms):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="BallisticDurationSlider" Minimum="50" Maximum="500" Value="150" TickFrequency="10" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=BallisticDurationSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Attack (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BallisticAttackSlider" Minimum="1" Maximum="100" Value="10" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=BallisticAttackSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Fade (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="BallisticFadeSlider" Minimum="10" Maximum="300" Value="120" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=BallisticFadeSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Lasers -->
                                <TextBlock Text="Lasers" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,15,0,5"/>
                                <TextBlock Text="Duration (ms):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="LaserDurationSlider" Minimum="50" Maximum="1000" Value="300" TickFrequency="10" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserDurationSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Frequency (Hz):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="LaserFrequencySlider" Minimum="10" Maximum="100" Value="40" TickFrequency="5" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserFrequencySlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Attack (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="LaserAttackSlider" Minimum="1" Maximum="100" Value="30" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserAttackSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Fade (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="LaserFadeSlider" Minimum="10" Maximum="300" Value="80" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=LaserFadeSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                
                                <!-- Machine Guns -->
                                <TextBlock Text="Machine Guns" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,15,0,5"/>
                                <TextBlock Text="Duration (ms):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MGDurationSlider" Minimum="20" Maximum="200" Value="60" TickFrequency="5" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MGDurationSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Frequency (Hz):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MGFrequencySlider" Minimum="10" Maximum="100" Value="33" TickFrequency="5" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MGFrequencySlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- PPCs -->
                                <TextBlock Text="PPCs" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,15,0,5"/>
                                <TextBlock Text="Duration (ms):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="PPCDurationSlider" Minimum="50" Maximum="500" Value="200" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=PPCDurationSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                
                                <!-- Missiles -->
                                <TextBlock Text="Missiles (Rumble)" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,15,0,5"/>
                                <TextBlock Text="Duration (ms):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MissileDurationSlider" Minimum="50" Maximum="1500" Value="200" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileDurationSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Frequency (Hz):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MissileFrequencySlider" Minimum="10" Maximum="100" Value="35" TickFrequency="5" 
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileFrequencySlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <TextBlock Text="Rumble Intensity (%):" FontSize="11" Margin="0,3,0,0"/>
                                <Grid Margin="0,2,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="60"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="MissileRumbleMultiplierSlider" Minimum="0" Maximum="100" Value="100" TickFrequency="10"
                                           ValueChanged="AdvancedSlider_ValueChanged"/>
                                    <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileRumbleMultiplierSlider, Path=Value, StringFormat={}{0:F0}}" 
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                        <TextBlock Text="Attack (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="MissileAttackSlider" Minimum="1" Maximum="100" Value="20" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileAttackSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                        <TextBlock Text="Fade (ms):" FontSize="11"/>
                                        <Grid Margin="0,2,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="50"/>
                                            </Grid.ColumnDefinitions>
                                            <Slider x:Name="MissileFadeSlider" Minimum="10" Maximum="600" Value="150" 
                                                   ValueChanged="AdvancedSlider_ValueChanged"/>
                                            <TextBlock Grid.Column="1" Text="{Binding ElementName=MissileFadeSlider, Path=Value, StringFormat={}{0:F0}}" 
                                                      HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>
                                    </StackPanel>
                                </Grid>
                                
                            </StackPanel>
                        </Expander>
                        
                        <!-- Movement Effects -->
                        <Expander Header="👣 Movement Effects" FontWeight="Bold" FontSize="13" Margin="0,5,0,5">
                            <StackPanel Margin="15,10,0,10">
                                
                                <!-- Footsteps -->
