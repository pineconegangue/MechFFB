                        <TextBlock Text="• Can run alongside MechShaker for ultimate immersion" 
                                  Opacity="0.8" Margin="10,5,0,0"/>
                        
                        <TextBlock Text="Requirements:" FontWeight="Bold" Margin="0,15,0,5"/>
